{
  "title": "Banking System — Application Logs",
  "uid": "banking-application-logs",
  "description": "Centralised log viewer for all banking microservices via Loki. Filter by service, log level, transaction ID, or free-text search. Sensitive data (passwords, tokens, credentials) is never logged.",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "tags": ["banking", "logs", "loki"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({job=\"banking-services\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "level",
        "label": "Log Level",
        "type": "custom",
        "options": [
          {
            "text": "All",
            "value": ".*",
            "selected": true
          },
          {
            "text": "ERROR",
            "value": "ERROR"
          },
          {
            "text": "WARN",
            "value": "WARN"
          },
          {
            "text": "INFO",
            "value": "INFO"
          },
          {
            "text": "DEBUG",
            "value": "DEBUG"
          }
        ],
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "txnId",
        "label": "Transaction ID",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "description": "Filter logs by a specific transactionId value (UUID format)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Volume by Level",
      "description": "Number of log entries per minute, stacked by severity level. Spikes in ERROR/WARN indicate incidents.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=~\"$service\"} | json | level =~ \"(?i)ERROR\" [1m]))",
          "legendFormat": "ERROR",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=~\"$service\"} | json | level =~ \"(?i)WARN\" [1m]))",
          "legendFormat": "WARN",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=~\"$service\"} | json | level =~ \"(?i)INFO\" [1m]))",
          "legendFormat": "INFO",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Recent ERROR Logs",
      "description": "All ERROR-level log lines across all banking services.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\"} | json | level =~ \"(?i)FAILED|insufficient|TransactionFailed|rejected|CLIENT_ERROR\" |~ \"(?i)$search\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 3,
      "title": "Recent WARN Logs",
      "description": "All WARN-level log lines. Idempotency conflicts, retries, and degraded-mode events appear here.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\"} | json | level =~ \"(?i)WARN\" |~ \"(?i)$search\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 100
        }
      ]
    },
    {
      "id": 4,
      "title": "All Logs by Service",
      "description": "All log levels filtered by the selected Service and optional free-text search.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\"} | json | level =~ \"(?i)$level\" |~ \"(?i)$search\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 5,
      "title": "Transaction-Related Logs (by Transaction ID)",
      "description": "Filter logs for a specific transaction by entering its UUID in the Transaction ID variable above.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\"} | json | transactionId =~ \"(?i)$txnId\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 6,
      "title": "Failed Transaction Logs",
      "description": "Log lines from transaction failures — insufficient balance, validation errors, or rejected mutations. Matches TransactionFailedEvent log entries and HTTP 422 responses.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\"} |~ \"(?i)FAILED|insufficient|TransactionFailed|rejected|CLIENT_ERROR\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 7,
      "title": "Idempotency Conflict & Replay Logs",
      "description": "Log lines emitted when duplicate/replay transactions are detected.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 54
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\"} |~ \"(?i)CONFLICT|REPLAY|idempotency\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 100
        }
      ]
    },
    {
      "id": 8,
      "title": "Log Count by Service (last hour)",
      "description": "Total log lines per service in the selected time range, broken down by severity.",
      "type": "barchart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "options": {
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "orientation": "auto",
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        },
        "xTickLabelRotation": -30
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} | json | level =~ \"(?i)ERROR\" [$__range]))",
          "legendFormat": "ERROR — {{service}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} | json | level =~ \"(?i)WARN\" [$__range]))",
          "legendFormat": "WARN — {{service}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} | json | level =~ \"(?i)INFO\" [$__range]))",
          "legendFormat": "INFO — {{service}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
