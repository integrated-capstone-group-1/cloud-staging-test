{
  "title": "Banking System — Transaction Monitoring",
  "uid": "banking-transaction-monitoring",
  "description": "Business-level transaction monitoring for the banking system. Counters are sourced from Micrometer (banking_transactions_total) in the transaction-service. Oracle remains the authoritative source for persisted records.",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "tags": ["banking", "transactions", "prometheus"],
  "panels": [

    {
      "id": 1,
      "title": "Total Transactions",
      "description": "Cumulative count of all banking transactions since service start (DEPOSIT + WITHDRAWAL + TRANSFER, all statuses).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(banking_transactions_total)",
          "legendFormat": "Total",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },

    {
      "id": 2,
      "title": "Successful Transactions",
      "description": "Cumulative count of transactions that completed with status=SUCCESS.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(banking_transactions_total{status=\"SUCCESS\"})",
          "legendFormat": "Success",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },

    {
      "id": 3,
      "title": "Failed Transactions",
      "description": "Cumulative count of transactions that completed with status=FAILED.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(banking_transactions_total{status=\"FAILED\"})",
          "legendFormat": "Failed",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },

    {
      "id": 4,
      "title": "Failure Rate (%)",
      "description": "Percentage of transactions that failed over the last 5 minutes. Protected against division-by-zero — shows 0 when no transactions have occurred.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(banking_transactions_total{status=\"FAILED\"}[5m])) / (sum(rate(banking_transactions_total[5m])) > 0 or vector(1))",
          "legendFormat": "Failure %",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }]
          }
        }
      }
    },

    {
      "id": 5,
      "title": "Idempotency Conflicts",
      "description": "Cumulative count of in-flight duplicate requests blocked by the Redis idempotency guard (tryLock returned false). A non-zero value means clients are retrying before the original request completes.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(banking_idempotency_conflicts_total)",
          "legendFormat": "Conflicts",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        }
      }
    },

    {
      "id": 6,
      "title": "Transaction Rate (tx/s)",
      "description": "Current transaction throughput — all types combined — over the last 5 minutes.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total[5m]))",
          "legendFormat": "tx/s",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },

    {
      "id": 7,
      "title": "Transactions by Type (cumulative)",
      "description": "Total count per transaction type since service start.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (type) (banking_transactions_total)",
          "legendFormat": "{{type}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      }
    },

    {
      "id": 8,
      "title": "Success / Failure by Type (cumulative)",
      "description": "Cumulative successes and failures broken down by type (DEPOSIT, WITHDRAWAL, TRANSFER).",
      "type": "bargauge",
      "gridPos": { "h": 4, "w": 16, "x": 8, "y": 4 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (type, status) (banking_transactions_total)",
          "legendFormat": "{{type}} / {{status}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*/FAILED" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*/SUCCESS" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      }
    },

    {
      "id": 9,
      "title": "Transaction Volume Over Time",
      "description": "Rate of transactions per second over the selected time window, broken down by type. Use this to see traffic patterns.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "sum"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (type) (rate(banking_transactions_total[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "color": { "mode": "palette-classic" } }
      }
    },

    {
      "id": 10,
      "title": "Success vs Failure Rate Over Time",
      "description": "SUCCESS and FAILED transaction rates (tx/s) over time. Divergence between the two lines indicates a problem.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total{status=\"SUCCESS\"}[5m])) or vector(0)",
          "legendFormat": "SUCCESS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total{status=\"FAILED\"}[5m])) or vector(0)",
          "legendFormat": "FAILED",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SUCCESS" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "FAILED"  }, "properties": [{ "id": "color", "value": { "fixedColor": "red",   "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 11,
      "title": "Failure Rate % Over Time",
      "description": "Rolling 5-minute failure percentage. Protected against division-by-zero. A rising trend here warrants immediate investigation.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(banking_transactions_total{status=\"FAILED\"}[5m])) / (sum(rate(banking_transactions_total[5m])) > 0 or vector(1))",
          "legendFormat": "Failure %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "color": { "fixedColor": "red", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] }
        }
      }
    },

    {
      "id": 12,
      "title": "Idempotency Conflicts Over Time",
      "description": "Rate of idempotency conflicts per second (duplicate in-flight requests blocked). A baseline above zero may indicate aggressive client retry behaviour.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_idempotency_conflicts_total[5m]))",
          "legendFormat": "Conflicts/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.1 }] }
        }
      }
    },

    {
      "id": 13,
      "title": "DEPOSIT — Success vs Failure",
      "description": "Deposit transaction outcomes over time (cumulative counter rate).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total{type=\"DEPOSIT\",status=\"SUCCESS\"}[5m])) or vector(0)",
          "legendFormat": "DEPOSIT SUCCESS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total{type=\"DEPOSIT\",status=\"FAILED\"}[5m])) or vector(0)",
          "legendFormat": "DEPOSIT FAILED",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "DEPOSIT SUCCESS" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "DEPOSIT FAILED"  }, "properties": [{ "id": "color", "value": { "fixedColor": "red",   "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 14,
      "title": "WITHDRAWAL — Success vs Failure",
      "description": "Withdrawal transaction outcomes over time.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total{type=\"WITHDRAWAL\",status=\"SUCCESS\"}[5m])) or vector(0)",
          "legendFormat": "WITHDRAWAL SUCCESS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total{type=\"WITHDRAWAL\",status=\"FAILED\"}[5m])) or vector(0)",
          "legendFormat": "WITHDRAWAL FAILED",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "WITHDRAWAL SUCCESS" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "WITHDRAWAL FAILED"  }, "properties": [{ "id": "color", "value": { "fixedColor": "red",   "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 15,
      "title": "TRANSFER — Success vs Failure",
      "description": "Transfer transaction outcomes over time. Includes both same-currency and cross-currency transfers. Cross-currency transfers that are PENDING (awaiting FX settlement) are not counted until settlement completes.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total{type=\"TRANSFER\",status=\"SUCCESS\"}[5m])) or vector(0)",
          "legendFormat": "TRANSFER SUCCESS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(banking_transactions_total{type=\"TRANSFER\",status=\"FAILED\"}[5m])) or vector(0)",
          "legendFormat": "TRANSFER FAILED",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "TRANSFER SUCCESS" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "TRANSFER FAILED"  }, "properties": [{ "id": "color", "value": { "fixedColor": "red",   "mode": "fixed" } }] }
        ]
      }
    }
  ]
}
