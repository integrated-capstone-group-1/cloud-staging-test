  "variables": {
    "$fxv#0": "#cloud-config\r\npackage_update: true\r\npackages:\r\n  - ca-certificates\r\n  - curl\r\n  - docker.io\r\n  - jq\r\n  - util-linux\r\n\r\nwrite_files:\r\n  - path: /usr/local/bin/start-oracle-xe\r\n    owner: root:root\r\n    permissions: \"0700\"\r\n    content: |\r\n      #!/usr/bin/env bash\r\n      set -euo pipefail\r\n\r\n      vault=\"__KEYVAULT_NAME__\"\r\n      sys_secret=\"__ORACLE_SYS_SECRET__\"\r\n      app_secret=\"__ORACLE_APP_SECRET__\"\r\n      app_user=\"__ORACLE_APP_USER__\"\r\n      image=\"__ORACLE_IMAGE__\"\r\n\r\n      if [ ! -f /opt/oracle/initdb/01_oracle_main_db.sql ] || [ ! -f /opt/oracle/initdb/02_seed_data_oracle.sql ]; then\r\n        echo \"Oracle init SQL files have not been staged yet.\" >&2\r\n        exit 1\r\n      fi\r\n\r\n      token=\"$(curl --fail --silent --show-error \\\r\n        -H Metadata:true \\\r\n        'http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net' \\\r\n        | jq -r '.access_token')\"\r\n      get_secret() {\r\n        curl --fail --silent --show-error \\\r\n          -H \"Authorization: Bearer $token\" \\\r\n          \"https://${vault}.vault.azure.net/secrets/$1?api-version=7.4\" \\\r\n          | jq -r '.value'\r\n      }\r\n\r\n      sys_password=\"$(get_secret \"$sys_secret\")\"\r\n      app_password=\"$(get_secret \"$app_secret\")\"\r\n\r\n      if ! mountpoint -q /opt/oracle/oradata; then\r\n        device=/dev/disk/azure/scsi1/lun0\r\n        if ! blkid \"$device\" >/dev/null 2>&1; then\r\n          mkfs.ext4 \"$device\"\r\n        fi\r\n        mkdir -p /opt/oracle/oradata\r\n        mount \"$device\" /opt/oracle/oradata\r\n        uuid=\"$(blkid -s UUID -o value \"$device\")\"\r\n        grep -q \"$uuid\" /etc/fstab || echo \"UUID=$uuid /opt/oracle/oradata ext4 defaults,nofail 0 2\" >> /etc/fstab\r\n      fi\r\n\r\n      docker pull \"$image\"\r\n      if docker container inspect oracle-db >/dev/null 2>&1; then\r\n        docker start oracle-db\r\n      else\r\n        docker run -d \\\r\n          --name oracle-db \\\r\n          --restart unless-stopped \\\r\n          --publish 1521:1521 \\\r\n          --volume /opt/oracle/oradata:/opt/oracle/oradata \\\r\n          --volume /opt/oracle/initdb:/container-entrypoint-initdb.d:ro \\\r\n          --env ORACLE_PASSWORD=\"$sys_password\" \\\r\n          --env APP_USER=\"$app_user\" \\\r\n          --env APP_USER_PASSWORD=\"$app_password\" \\\r\n          \"$image\"\r\n      fi\r\n\r\nruncmd:\r\n  - [bash, -lc, \"set -e; device=/dev/disk/azure/scsi1/lun0; for i in $(seq 1 30); do [ -b \\\"$device\\\" ] && break; sleep 2; done; systemctl enable --now docker; mkdir -p /opt/oracle/oradata /opt/oracle/initdb; cat > /etc/systemd/system/oracle-xe.service <<'UNIT'\\n[Unit]\\nDescription=Oracle XE container\\nAfter=docker.service network-online.target\\nRequires=docker.service\\n[Service]\\nType=oneshot\\nRemainAfterExit=yes\\nExecStart=/usr/local/bin/start-oracle-xe\\nRestart=on-failure\\nRestartSec=60\\n[Install]\\nWantedBy=multi-user.target\\nUNIT\\nsystemctl daemon-reload; systemctl enable oracle-xe.service; systemctl start oracle-xe.service || logger -t oracle-xe 'Oracle start will retry after SQL files are staged.'\"]\r\n",
